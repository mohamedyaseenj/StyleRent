# StyleRent frontend environment variables
# Copy this file to .env and adjust values locally.
# NEVER commit real secrets.

# Base URL for the Spring Boot REST API (live Render backend).
# For local backend development use: http://localhost:8080/api
VITE_API_BASE_URL=https://stylerent-backend.onrender.com/api

# Run the app with mock data when the backend is unreachable (default true).
# Set to false to talk to the live backend; mock data remains as fallback.
VITE_API_MOCK=false